{
  "name": "gunther-console",
  "version": "1.0.0",
  "description": "Gunther \u2014 personal autonomous coding console",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node test/engine.test.mjs && node test/smoke.test.mjs",
    "pack:www": "node tools/pack-www.mjs",
    "sync": "node tools/pack-www.mjs && npx cap sync android",
    "apk:debug": "node tools/pack-www.mjs && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thepotatoninjahost/Gunther.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/thepotatoninjahost/Gunther/issues"
  },
  "homepage": "https://github.com/thepotatoninjahost/Gunther#readme",
  "type": "module",
  "devDependencies": {
    "jsdom": "^30.0.1"
  },
  "private": "true",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
